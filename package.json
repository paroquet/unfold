{
  "name": "unfold-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:contract": "UNFOLD_CONTRACT=1 vitest run packages/*/tests/contract --passWithNoTests",
    "test:e2e": "pnpm -r build && UNFOLD_E2E=1 vitest run packages/*/tests/e2e --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
